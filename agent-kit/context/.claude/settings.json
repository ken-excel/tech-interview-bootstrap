{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "enableAllProjectMcpServers": true,
  "permissions": {
    "allow": [
      "Bash(cargo build:*)", "Bash(cargo run:*)", "Bash(cargo test:*)",
      "Bash(cargo check:*)", "Bash(cargo clippy:*)", "Bash(cargo fmt:*)", "Bash(cargo add:*)",
      "Bash(uv run:*)", "Bash(uv sync:*)", "Bash(uv add:*)", "Bash(uvx ruff:*)",
      "Bash(npm run:*)", "Bash(npm test:*)", "Bash(npm install:*)", "Bash(npx vitest:*)", "Bash(npx tsc:*)",
      "Bash(./diagrams/render.sh:*)", "Bash(d2:*)", "Bash(mmdc:*)", "Bash(dot:*)",
      "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git add:*)", "Bash(git commit:*)",
      "Bash(ls:*)", "Bash(cat:*)", "Bash(rg:*)", "Bash(fd:*)", "Bash(jq:*)", "Bash(tree:*)",
      "mcp__context7", "mcp__sequential-thinking"
    ],
    "deny": [
      "Bash(rm -rf /*)", "Bash(git push --force:*)", "Bash(git reset --hard:*)",
      "Read(./.env)", "Read(./**/.env)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          { "type": "command", "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/format.sh", "timeout": 30 }
        ]
      }
    ]
  }
}
