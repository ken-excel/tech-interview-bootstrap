# tech-interview-bootstrap configuration.
# Override any value by exporting it before running ./bootstrap.sh, e.g.
#   WORKSPACE=~/code/interview PYTHON_VERSION=3.13 ./bootstrap.sh

# Everything the kit installs (toolchains, caches, agent config) lives here,
# so uninstall is mostly "rm -rf this folder".
: "${IBX_HOME:=$HOME/.interview-env}"

# Where your interview workspace (agent context, PoC starters, docs) is created.
: "${WORKSPACE:=$HOME/interview}"

# Toolchain versions.
: "${PYTHON_VERSION:=3.14}"
: "${NODE_VERSION:=lts-latest}"     # anything `fnm install` accepts: lts-latest, 24, 22 ...
: "${RUST_TOOLCHAIN:=stable}"

# Small CLI tools from Homebrew. Only formulae that were NOT already installed
# are recorded, so uninstall never removes something you had before.
: "${BREW_FORMULAE:=jq ripgrep fd gh d2 graphviz shellcheck tree}"

# Optional GUI apps (Homebrew casks). Empty by default; e.g.
#   BREW_CASKS="visual-studio-code ghostty" ./bootstrap.sh
: "${BREW_CASKS:=}"

# Global npm packages installed into the sandboxed Node (not your system Node).
: "${NPM_GLOBALS:=@openai/codex @mermaid-js/mermaid-cli}"

# Agent CLIs to set up: any of "claude codex".
: "${AGENTS:=claude codex}"

# Third-party skill repos cloned (shallow) and linked into the workspace.
# Format: <git-url>|<subdir containing skill folders>|<space-separated skill names>
# Separate multiple repos with ';'.
: "${VENDOR_SKILLS:=https://github.com/anthropics/skills|skills|webapp-testing mcp-builder frontend-design skill-creator}"

# Pre-build the starter projects so the first build during the call is instant.
: "${WARM_CACHES:=1}"
